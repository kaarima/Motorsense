// Minimal STM32G474 digital twin for reset, SysTick, and GPIO smoke tests.
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    systickFrequency: 4000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x80000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x18000

ccmram: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x8000

rcc: Memory.MappedMemory @ sysbus 0x40021000
    size: 0x1000

gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>
    modeResetValue: 0xFFFFFFFF

led: Miscellaneous.LED @ gpioPortA

gpioPortA:
    5 -> led@0
